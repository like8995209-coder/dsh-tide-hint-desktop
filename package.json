    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3",
    "vite": "^7.3.8"
  }
